# Copie para .env e ajuste. Nenhuma variável é obrigatória para rodar localmente.

# Porta HTTP
PORT=3000

# Caminho do banco SQLite (padrão: data/travelcash.db). Use :memory: para banco temporário.
# DB_FILE=data/travelcash.db

# Popular o banco com data/seed.json na primeira execução (true/false)
SEED_DB=true

# Origem permitida no CORS (padrão: *)
# CORS_ORIGIN=http://localhost:3000

# ---------- IA (LLM) ----------
# Provedor: gemini | anthropic | none
# Sem chave, a aplicação funciona com regras locais (fallback) e indica source="regras".
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Google Gemini (tem camada gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LLn7ymOatQ1RmeOFc86RzgqpHiStPGPCpVWFJMKI3y2Q

# Anthropic Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Modelo (opcional). Padrões: gemini-2.5-flash | claude-haiku-4-5
# LLM_MODEL=

# Tempo limite de chamada ao modelo (ms) e cache de análises (ms)
LLM_TIMEOUT_MS=40000
LLM_CACHE_TTL_MS=600000

# Limites de requisição por minuto (por IP)
AI_RATE_LIMIT_PER_MIN=20
API_RATE_LIMIT_PER_MIN=300
